{
  "name": "kovari",
  "version": "0.1.12",
  "description": "Typed policy-driven runtime for auditable AI agents, tools, MCP, events and secure workspaces.",
  "keywords": [
    "kovari",
    "typescript",
    "developer-tools",
    "ide",
    "agents",
    "runtime"
  ],
  "homepage": "https://github.com/LoonCodeHunter/kovari#readme",
  "bugs": {
    "url": "https://github.com/LoonCodeHunter/kovari/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoonCodeHunter/kovari.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/LoonCodeHunter"
  },
  "license": "MIT",
  "author": {
    "name": "LoonCodeHunter",
    "url": "https://github.com/LoonCodeHunter"
  },
  "contributors": [
    "Kovari contributors"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "packageManager": "npm@10.9.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js",
      "default": "./dist/security.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "import": "./dist/logging.js",
      "default": "./dist/logging.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js",
      "default": "./dist/models.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "default": "./dist/tools.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "default": "./dist/sdk.js"
    },
    "./assets/icon.png": "./assets/icon.png",
    "./assets/icon-128.png": "./assets/icon-128.png",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "API.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "LICENSE",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests",
    "example": "examples"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:verify": "npm run build && npm run validate:exports",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs tests/workspace-security.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:all": "npm run test:unit && npm run test:integration",
    "validate:source": "node scripts/validate-source.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:exports": "node scripts/validate-exports.mjs",
    "validate:lock": "node scripts/validate-lock.mjs",
    "validate:publish": "node scripts/validate-publish.mjs",
    "validate": "npm run validate:source && npm run validate:package && npm run validate:assets && npm run validate:exports && npm run validate:lock && npm run validate:publish",
    "check": "npm run typecheck && npm run build && npm run test:all && npm run validate",
    "pack:verify": "node scripts/verify-package.mjs",
    "pack:dry": "npm pack --dry-run --ignore-scripts",
    "publish:dry": "npm publish --dry-run --ignore-scripts --provenance=false",
    "security": "npm audit --audit-level=high",
    "release:check": "npm run check && npm run pack:verify && npm run pack:dry && npm run publish:dry",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "22.18.11",
    "typescript": "5.9.3"
  }
}
